<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ekagra.controller.NotificationsController" spacing="14">
    <HBox styleClass="card,filter-bar" spacing="12" alignment="CENTER_LEFT">
        <HBox>
            <ToggleButton fx:id="allToggle" text="All" styleClass="left-pill" selected="true"/>
            <ToggleButton fx:id="unreadToggle" text="Unread" styleClass="right-pill"/>
        </HBox>
        <Label fx:id="summary" styleClass="muted,small"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Mark all as read" onAction="#onMarkAllRead">
            <graphic><FontIcon iconLiteral="fth-check"/></graphic>
        </Button>
        <Button text="Clear all" onAction="#onClearAll">
            <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
        </Button>
    </HBox>
    <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS" prefHeight="100">
        <VBox fx:id="list" spacing="8"/>
    </ScrollPane>
</VBox>
