<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ekagra.controller.TasksController" spacing="12">

    <!-- Summary tiles -->
    <HBox fx:id="statsRow" spacing="14"/>

    <!-- Deadline alert (FR-08) -->
    <HBox fx:id="alertBanner" styleClass="alert-banner" spacing="10" alignment="CENTER_LEFT"
          visible="false" managed="false">
        <FontIcon iconLiteral="fth-alert-triangle"/>
        <Label fx:id="alertText" styleClass="alert-text"/>
    </HBox>

    <!-- Toolbar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search tasks…" prefWidth="170" minWidth="120" HBox.hgrow="SOMETIMES"/>
        <ComboBox fx:id="statusFilter" prefWidth="128"/>
        <ComboBox fx:id="priorityFilter" prefWidth="128"/>
        <ComboBox fx:id="subjectFilter" prefWidth="132"/>
        <ComboBox fx:id="sortBox" prefWidth="112"/>
        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
        <HBox>
            <ToggleButton fx:id="listToggle" styleClass="left-pill" selected="true">
                <graphic><FontIcon iconLiteral="fth-list"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="weekToggle" styleClass="right-pill">
                <graphic><FontIcon iconLiteral="fth-calendar"/></graphic>
            </ToggleButton>
        </HBox>
        <Button text="New task" styleClass="accent" onAction="#onNewTask" minWidth="-Infinity">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <!-- List view -->
        <ScrollPane fx:id="listView" fitToWidth="true" styleClass="page-scroll">
            <VBox fx:id="taskList" spacing="10"/>
        </ScrollPane>

        <!-- Week calendar view (FR-09) -->
        <VBox fx:id="weekView" spacing="12" visible="false">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button styleClass="icon-button" onAction="#onPrevWeek">
                    <graphic><FontIcon iconLiteral="fth-chevron-left"/></graphic>
                </Button>
                <Button text="This week" onAction="#onThisWeek"/>
                <Button styleClass="icon-button" onAction="#onNextWeek">
                    <graphic><FontIcon iconLiteral="fth-chevron-right"/></graphic>
                </Button>
                <Label fx:id="weekLabel" styleClass="h3"/>
            </HBox>
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                <GridPane fx:id="weekGrid" styleClass="week-grid" hgap="10"/>
            </ScrollPane>
        </VBox>
    </StackPane>
</VBox>
