<?xml version="1.0" encoding="UTF-8"?>

<?import com.ekagra.ui.BrandPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ekagra.controller.LoginController" styleClass="auth-root">

    <BrandPane/>

    <VBox alignment="CENTER" styleClass="auth-side" HBox.hgrow="ALWAYS">
        <VBox styleClass="auth-form" spacing="10" maxWidth="380" prefWidth="380">
            <Label text="Welcome back" styleClass="h1"/>
            <Label text="Log in to continue your focus journey." styleClass="muted"/>

            <Label text="Email" styleClass="field-label">
                <VBox.margin><Insets top="18"/></VBox.margin>
            </Label>
            <TextField fx:id="emailField" promptText="you@university.edu"/>

            <Label text="Password" styleClass="field-label">
                <VBox.margin><Insets top="6"/></VBox.margin>
            </Label>
            <PasswordField fx:id="passwordField" promptText="Your password" onAction="#onLogin"/>

            <Label fx:id="errorLabel" styleClass="error-label" maxWidth="Infinity" visible="false" managed="false"/>

            <Button text="Log in" styleClass="accent,auth-button" maxWidth="Infinity"
                    defaultButton="true" onAction="#onLogin">
                <VBox.margin><Insets top="12"/></VBox.margin>
            </Button>

            <HBox alignment="CENTER" spacing="2">
                <Label text="New to Ekagra?" styleClass="muted"/>
                <Hyperlink text="Create an account" onAction="#onGoToSignup"/>
            </HBox>

            <VBox styleClass="demo-box" spacing="6">
                <VBox.margin><Insets top="18"/></VBox.margin>
                <Label text="Just looking around?" styleClass="field-label"/>
                <Label text="Load two weeks of sample data and explore every feature." styleClass="muted,small" wrapText="true"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="demoStudentButton" text="Explore as a student" onAction="#onDemoStudent"/>
                    <Button fx:id="demoMentorButton" text="Explore as a mentor" onAction="#onDemoMentor"/>
                </HBox>
                <Label fx:id="demoStatus" styleClass="muted,small" wrapText="true"/>
            </VBox>
        </VBox>
    </VBox>
</HBox>
