<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ekagra.controller.GoalsController"
            fitToWidth="true" styleClass="page-scroll">
    <HBox spacing="14">

        <!-- Goals -->
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS" minWidth="420">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2">
                    <Label text="Goals" styleClass="h3"/>
                    <Label fx:id="goalSummary" styleClass="muted,small"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="New goal" styleClass="accent" onAction="#onAddGoal">
                    <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                </Button>
            </HBox>
            <VBox fx:id="goalList" spacing="10"/>
        </VBox>

        <!-- Habits -->
        <VBox styleClass="card" spacing="12" prefWidth="480" minWidth="430">
            <VBox spacing="2">
                <Label text="Habits" styleClass="h3"/>
                <Label text="Tick a day to mark it done. Click again to undo." styleClass="muted,small"/>
            </VBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <ComboBox fx:id="habitIcon" prefWidth="78"/>
                <TextField fx:id="habitTitle" promptText="New habit, e.g. Read 20 minutes" HBox.hgrow="ALWAYS" onAction="#onAddHabit"/>
                <Button text="Add" onAction="#onAddHabit"/>
            </HBox>
            <Label fx:id="habitMessage" visible="false" managed="false"/>
            <VBox fx:id="habitList" spacing="10"/>
        </VBox>
    </HBox>
</ScrollPane>
