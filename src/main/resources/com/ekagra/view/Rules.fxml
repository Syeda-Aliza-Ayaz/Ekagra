<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ekagra.controller.RulesController" spacing="14">

    <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" minWidth="520">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="Classification rules" styleClass="h3"/>
                <Label fx:id="ruleCount" styleClass="muted,small"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="search" promptText="Search rules…" prefWidth="180"/>
            <ComboBox fx:id="categoryFilter" prefWidth="150"/>
        </HBox>
        <HBox styleClass="rule-header" spacing="10">
            <Label text="APP" prefWidth="170" styleClass="nav-group-label"/>
            <Label text="WINDOW TITLE" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="-Infinity" styleClass="nav-group-label"/>
            <Label text="CATEGORY" prefWidth="170" styleClass="nav-group-label"/>
            <Region prefWidth="40"/>
        </HBox>
        <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS" prefHeight="100" minHeight="100">
            <VBox fx:id="ruleList" spacing="4"/>
        </ScrollPane>
    </VBox>

    <ScrollPane fitToWidth="true" styleClass="page-scroll" prefWidth="390" minWidth="350" prefHeight="100">
    <VBox spacing="14">
        <VBox styleClass="card" spacing="8">
            <Label text="Add a rule" styleClass="h3"/>
            <Label text="App (process name)" styleClass="field-label"/>
            <TextField fx:id="newProcess" promptText="e.g. discord or discord.exe (optional)"/>
            <Label text="Window title contains" styleClass="field-label"/>
            <TextField fx:id="newKeyword" promptText="e.g. YouTube (optional)"/>
            <Label text="Category" styleClass="field-label"/>
            <ComboBox fx:id="newCategory" maxWidth="Infinity"/>
            <Label text="Tip: title keywords work for websites in any browser. When both are filled, both must match."
                   styleClass="muted,small" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="addMessage" visible="false" managed="false"/>
            <HBox>
                <Button text="Add rule" styleClass="accent" onAction="#onAdd">
                    <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="8">
            <Label text="Test a window" styleClass="h3"/>
            <Label text="See how Ekagra would classify an app or website." styleClass="muted,small" wrapText="true"/>
            <TextField fx:id="testProcess" promptText="App, e.g. chrome"/>
            <TextField fx:id="testTitle" promptText="Window title, e.g. Lecture 5 - YouTube"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Test" onAction="#onTest"/>
                <Label fx:id="testResult"/>
            </HBox>
        </VBox>
    </VBox>
    </ScrollPane>
</HBox>
