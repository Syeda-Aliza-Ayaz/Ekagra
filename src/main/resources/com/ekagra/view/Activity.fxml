<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ekagra.controller.ActivityController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="14">

        <!-- Live view + today's totals -->
        <HBox spacing="14">
            <VBox styleClass="card,now-card" spacing="10" HBox.hgrow="ALWAYS" minWidth="360">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Right now" styleClass="h3"/>
                    <Label fx:id="statusLabel" styleClass="status-pill"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="pauseButton" onAction="#onTogglePause"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane fx:id="nowIconHolder" styleClass="now-icon"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="nowApp" styleClass="now-app"/>
                        <Label fx:id="nowTitle" styleClass="muted" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="nowCategory"/>
                    <Label fx:id="nowDuration" styleClass="muted,small"/>
                </HBox>
            </VBox>
            <HBox fx:id="tiles" spacing="14"/>
        </HBox>

        <!-- Balance bar -->
        <VBox styleClass="card" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Today's balance" styleClass="h3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="balanceCaption" styleClass="muted,small"/>
            </HBox>
            <HBox fx:id="balanceBar" styleClass="balance-bar" spacing="2"/>
            <HBox fx:id="balanceLegend" spacing="26"/>
        </VBox>

        <!-- Hourly chart + top apps -->
        <HBox spacing="14">
            <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS" minWidth="420">
                <Label text="By hour" styleClass="h3"/>
                <Label text="Minutes of screen time in each hour today" styleClass="muted,small"/>
                <StackPane fx:id="chartHolder" prefHeight="250" minHeight="230"/>
            </VBox>
            <VBox styleClass="card" spacing="10" prefWidth="360" minWidth="320">
                <Label text="Top apps today" styleClass="h3"/>
                <VBox fx:id="topApps" spacing="12"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
