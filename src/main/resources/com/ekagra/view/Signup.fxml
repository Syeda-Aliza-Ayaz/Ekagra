<?xml version="1.0" encoding="UTF-8"?>

<?import com.ekagra.ui.BrandPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ekagra.controller.SignupController" styleClass="auth-root">

    <BrandPane/>

    <ScrollPane fitToWidth="true" styleClass="page-scroll" HBox.hgrow="ALWAYS">
        <VBox alignment="CENTER" styleClass="auth-side">
            <VBox styleClass="auth-form" spacing="8" maxWidth="400" prefWidth="400">
                <Label text="Create your account" styleClass="h1"/>
                <Label text="Start building focus that lasts." styleClass="muted"/>

                <Label text="I am a" styleClass="field-label">
                    <VBox.margin><Insets top="14"/></VBox.margin>
                </Label>
                <HBox>
                    <ToggleButton fx:id="studentToggle" text="Student" styleClass="left-pill"
                                  maxWidth="Infinity" HBox.hgrow="ALWAYS" selected="true"/>
                    <ToggleButton fx:id="mentorToggle" text="Mentor" styleClass="right-pill"
                                  maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label text="Full name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. Ayesha Khan"/>

                <Label text="Email" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="you@university.edu"/>

                <VBox fx:id="studentFields" spacing="8">
                    <HBox spacing="12">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="University" styleClass="field-label"/>
                            <TextField fx:id="universityField" promptText="e.g. NED University"/>
                        </VBox>
                        <VBox spacing="8" prefWidth="140">
                            <Label text="Semester" styleClass="field-label"/>
                            <Spinner fx:id="semesterSpinner" editable="true" maxWidth="Infinity" minWidth="130"/>
                        </VBox>
                    </HBox>
                    <Label text="Mentor code (optional)" styleClass="field-label"/>
                    <TextField fx:id="mentorCodeField" promptText="e.g. EK-7KQ2M"/>
                </VBox>

                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="At least 6 characters"/>

                <Label text="Confirm password" styleClass="field-label"/>
                <PasswordField fx:id="confirmField" promptText="Type it again" onAction="#onSignup"/>

                <Label fx:id="errorLabel" styleClass="error-label" maxWidth="Infinity" visible="false" managed="false"/>

                <Button text="Create account" styleClass="accent,auth-button" maxWidth="Infinity"
                        defaultButton="true" onAction="#onSignup">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="2">
                    <Label text="Already have an account?" styleClass="muted"/>
                    <Hyperlink text="Log in" onAction="#onGoToLogin"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
