<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ekagra.controller.MainLayoutController" styleClass="main-root">

    <left>
        <VBox styleClass="sidebar" prefWidth="244" minWidth="244">
            <HBox fx:id="brandBox" styleClass="sidebar-brand" spacing="10" alignment="CENTER_LEFT">
                <Label text="ekagra" styleClass="sidebar-wordmark"/>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="navBox" spacing="2"/>
            </ScrollPane>

            <HBox fx:id="userCard" styleClass="user-card" alignment="CENTER_LEFT" onMouseClicked="#onOpenProfile">
                <StackPane fx:id="avatarHolder"/>
                <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                    <Label fx:id="userNameLabel" styleClass="user-name"/>
                    <Label fx:id="userSubtitleLabel" styleClass="muted,small"/>
                </VBox>
                <Button styleClass="icon-button" onAction="#onLogout">
                    <graphic><FontIcon iconLiteral="fth-log-out"/></graphic>
                    <tooltip><Tooltip text="Log out"/></tooltip>
                </Button>
            </HBox>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label fx:id="pageTitle" styleClass="page-title"/>
                        <Label fx:id="dateLabel" styleClass="muted,small"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="trackingChip" styleClass="tracking-chip" onAction="#onOpenActivity" visible="false" managed="false">
                        <tooltip><Tooltip text="Activity tracking status: click to open Activity Monitor"/></tooltip>
                    </Button>
                    <Button fx:id="timerChip" styleClass="timer-chip" onAction="#onOpenFocus" visible="false" managed="false">
                        <graphic><FontIcon iconLiteral="fth-clock"/></graphic>
                        <tooltip><Tooltip text="Open Focus Timer"/></tooltip>
                    </Button>
                    <Button fx:id="themeButton" styleClass="icon-button" onAction="#onToggleTheme">
                        <tooltip><Tooltip text="Toggle light / dark"/></tooltip>
                    </Button>
                    <StackPane>
                        <Button styleClass="icon-button" onAction="#onOpenNotifications">
                            <graphic><FontIcon iconLiteral="fth-bell"/></graphic>
                            <tooltip><Tooltip text="Notifications"/></tooltip>
                        </Button>
                        <Label fx:id="bellBadge" styleClass="bell-badge" visible="false" mouseTransparent="true"
                               StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="content" styleClass="content"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
